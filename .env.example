# Universal Analytical Agent — Milestone 1 configuration
#
# Copy this file to .env only for local reference. The application intentionally
# reads process environment variables; a deployment system should inject values.

# Optional. Defaults to "development". Valid values: development, test, production.
UAA_ENVIRONMENT=development

# Optional. Defaults to "INFO". Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
UAA_LOG_LEVEL=INFO

# Required only when UAA_ENVIRONMENT=production. This non-secret identifier is
# included in future operational events to identify a deployed instance.
# UAA_DEPLOYMENT_ID=production-instance-1

# Optional Ollama provider values. All three are required only when constructing
# an OllamaProvider; there are deliberately no localhost or model defaults.
# UAA_OLLAMA_BASE_URL=https://ollama.example.internal
# UAA_OLLAMA_MODEL=approved-model-name
# UAA_OLLAMA_TIMEOUT_SECONDS=30

# Optional. Defaults to 4. Positive maximum LLM/action steps for one agent run.
UAA_AGENT_MAX_STEPS=4
